# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=        # E.164, e.g. +14155551234

# Deepgram
DEEPGRAM_API_KEY=

# Supabase
SUPABASE_URL=               # Project URL only, e.g. https://abc.supabase.co (no /rest/v1)
SUPABASE_SERVICE_KEY=       # secret / service_role key, never the publishable key

# Google (demo account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Meta Model API (Muse Spark): the browser agent that operates REAL's DashDish and Udriver clones
META_API_KEY=
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=low       # minimal | low | medium | high
BROWSER_HEADLESS=false          # false = show the Chromium window (demo); true for servers
BROWSER_USE_SCREENSHOT=true     # false = accessibility tree only (faster, ~50s vs ~65s per order)
REAL_DASHDISH_URL=https://evals-dashdish.vercel.app
REAL_UDRIVER_URL=https://evals-udriver.vercel.app

# App
PUBLIC_BASE_URL=            # public backend URL (ngrok or host) for Twilio webhooks
MOCK_SERVICES_BASE_URL=     # web/ deployment URL
DEMO_USER_ID=
POLICY_SPENDING_LIMIT=100
FAMILY_CHANNEL=sms            # sms (needs A2P 10DLC registration) or whatsapp (Twilio sandbox)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# jev-ultrafast experiment (branch jev-ultrafast)
TYPESAFE_API_KEY=
JEV_CDP_WS=                 # websocket of a Chromium started with --remote-debugging-port (see scripts/compare_agents.py)
