# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=        # E.164, e.g. +14155551234

# Deepgram
DEEPGRAM_API_KEY=

# Supabase
SUPABASE_URL=               # Project URL only, e.g. https://abc.supabase.co (no /rest/v1)
SUPABASE_SERVICE_KEY=       # secret / service_role key, never the publishable key
SUPABASE_ANON_KEY=          # publishable key for the web dashboard only

# Google (demo account — real Gmail + Calendar APIs, OAuth consent in Testing mode)
# 1. Enable Gmail API + Google Calendar API on a Cloud project
# 2. Create an OAuth Desktop client; add the demo Gmail as a Testing-mode test user
# 3. From backend/: uv run python scripts/google_oauth.py  -> paste refresh token here
# 4. uv run python scripts/seed_gmail.py && uv run python scripts/ingest_gmail.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# OpenRouter: the browser agent that operates REAL's DashDish and Udriver clones
OPENROUTER_API_KEY=
MUSE_MODEL=anthropic/claude-haiku-4.5
BROWSER_HEADLESS=false          # false = show the Chromium window (demo); true for servers
BROWSER_USE_SCREENSHOT=true     # false = accessibility tree only (faster)
REAL_DASHDISH_URL=https://evals-dashdish.vercel.app
REAL_UDRIVER_URL=https://evals-udriver.vercel.app
TASKHARE_URL=http://127.0.0.1:3000/taskhare

# Jev (TypeSafe) decider for DashDish, Udriver, and TaskHare. llm keeps Claude Haiku.
JEV_API_KEY=
BROWSER_DECIDER=llm             # llm | jev

# App
PUBLIC_BASE_URL=            # public backend URL (ngrok or host) for Twilio webhooks
MOCK_SERVICES_BASE_URL=     # web/ deployment URL
DEMO_USER_ID=
POLICY_SPENDING_LIMIT=100
POLICY_HARD_LIMIT=20          # one-off (non-recurring) payments above this need family approval
FAMILY_CHANNEL=whatsapp       # sms (needs A2P 10DLC registration) or whatsapp (Twilio sandbox)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
