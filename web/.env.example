# Only needed when deployed (Vercel). Locally, next.config.mjs reads these from the repo-root .env:
#   SUPABASE_URL -> NEXT_PUBLIC_SUPABASE_URL, SUPABASE_ANON_KEY -> NEXT_PUBLIC_SUPABASE_ANON_KEY, DEMO_USER_ID
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable / anon key only, never the secret key
NEXT_PUBLIC_DEMO_USER_ID=
